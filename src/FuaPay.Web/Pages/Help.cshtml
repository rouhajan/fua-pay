@page
@{
    ViewData["Title"] = "Nápověda";
}

<section class="functional-page narrow-page">
    <header class="functional-header">
        <div><p class="panel-kicker">FUA Pay</p><h1>Nápověda</h1><p>Základní informace k zakázkám, kreditu a platbám.</p></div>
    </header>

    <section class="data-panel form-stack">
        <div><h2>Zákazník</h2><p>Kredit a zveřejněné zakázky jsou vedené na univerzitní identitu. Zakázku lze zaplatit kreditem nebo přímou platbou.</p></div>
        <div><h2>Zadavatel</h2><p>Zadavatel vidí pouze zakázky pracovišť, která mu přidělil administrátor. Více zadavatelů stejného pracoviště sdílí jednu frontu.</p></div>
        <div><h2>Platby</h2><p>Rozhodující je stav v aplikaci. Opakované potvrzení stejné platby nezpůsobí druhé připsání kreditu ani druhou úhradu zakázky.</p></div>
        <div><h2>Podpora</h2><p>Kontaktní údaje fakulty budou doplněny před pilotním provozem.</p></div>
    </section>
</section>
