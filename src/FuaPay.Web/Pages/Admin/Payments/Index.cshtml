@page
@model FuaPay.Web.Pages.Admin.Payments.IndexModel
@using System.Globalization
@using FuaPay.Web.Modules.Payments.Domain
@{
    ViewData["Title"] = "Platby";
    var previousOffset = Math.Max(0, Model.Payments.Offset - Model.Payments.Limit);
    var nextOffset = Model.Payments.Offset + Model.Payments.Limit;
    var statuses = new[]
    {
        PaymentStatus.Pending,
        PaymentStatus.Succeeded,
        PaymentStatus.Failed,
        PaymentStatus.Cancelled,
        PaymentStatus.Expired
    };
}

<section class="functional-page">
    <header class="functional-header">
        <div>
            <p class="panel-kicker">Administrace</p>
            <h1>Platby</h1>
            <p>Přehled interních platebních pokusů a jejich potvrzení. Ruční označení úhrady zde není možné.</p>
        </div>
    </header>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="message-box is-success">@statusMessage</div>
    }
    <div fua-validation-summary="All" class="message-box is-error"></div>

    <form method="get" class="filter-grid customer-filter-grid">
        <input type="hidden" name="view" value="admin" />
        <label>
            <span>Reference</span>
            <input type="search" name="search" value="@Model.Search" />
        </label>
        <label>
            <span>Stav</span>
            <select name="status">
                <option value="">Všechny</option>
                @foreach (var status in statuses)
                {
                    <option value="@status"
                            selected="@(Model.Status == status ? "selected" : null)">
                        @PaymentDisplay.StatusLabel(status)
                    </option>
                }
            </select>
        </label>
        <label>
            <span>Účel</span>
            <select name="purposeType">
                <option value="">Všechny</option>
                <option value="@PaymentPurposeType.CreditTopUp"
                        selected="@(Model.PurposeType == PaymentPurposeType.CreditTopUp ? "selected" : null)">
                    Dobití kreditu
                </option>
                <option value="@PaymentPurposeType.Job"
                        selected="@(Model.PurposeType == PaymentPurposeType.Job ? "selected" : null)">
                    Zakázka
                </option>
            </select>
        </label>
        <div class="filter-actions">
            <button type="submit" class="secondary-button">Použít filtry</button>
            <a asp-page="./Index" asp-route-view="admin" class="text-link">Vyčistit</a>
        </div>
    </form>

    <section class="data-panel">
        <div class="data-panel-header">
            <h2>Platební záznamy</h2>
            <span>@Model.Payments.TotalCount celkem</span>
        </div>
        @if (Model.Payments.Items.Count == 0)
        {
            <div class="empty-state">
                <p>Žádná platba neodpovídá filtru.</p>
            </div>
        }
        else
        {
            <div class="responsive-table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Datum</th>
                            <th>Zákazník</th>
                            <th>Účel</th>
                            <th>Částka</th>
                            <th>Stav</th>
                            <th>Reference</th>
                            <th>Vratka</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var payment in Model.Payments.Items)
                    {
                        var user = Model.Users.GetValueOrDefault(payment.CustomerUserId);
                        var settlementReturns =
                            Model.SettlementReturns.GetValueOrDefault(payment.Id)
                            ?? [];
                        var reservedMinorUnits = settlementReturns
                            .Where(item => item.State != SettlementReturnState.Rejected)
                            .Sum(item => item.AmountMinorUnits);
                        var remainingMinorUnits = Math.Max(
                            0,
                            payment.AmountMinorUnits - reservedMinorUnits);
                        <tr>
                            <td>@DashboardDisplay.FormatDate(payment.CreatedAt)</td>
                            <td>
                                <strong>@(user?.DisplayName ?? "Neznámý")</strong>
                                <small>@user?.Email</small>
                            </td>
                            <td>@PaymentDisplay.PurposeLabel(payment.PurposeType)</td>
                            <td><strong>@DashboardDisplay.FormatMoney(payment.AmountMinorUnits)</strong></td>
                            <td>
                                <span class="status-badge @PaymentDisplay.StatusCssClass(payment.Status)">
                                    @PaymentDisplay.StatusLabel(payment.Status)
                                </span>
                            </td>
                            <td><code>@payment.ProviderReference</code></td>
                            <td>
                                @if (
                                    payment.Provider == PaymentProvider.Csob &&
                                    payment.PurposeType == PaymentPurposeType.Job &&
                                    payment.Status == PaymentStatus.Succeeded)
                                {
                                    if (settlementReturns.Count > 0)
                                    {
                                        <div class="return-history" data-return-history>
                                            @foreach (var settlementReturn in settlementReturns)
                                            {
                                                var isPartial =
                                                    settlementReturn.AmountMinorUnits <
                                                    payment.AmountMinorUnits;
                                                <div class="return-history-item"
                                                     data-return-id="@settlementReturn.SettlementReturnId">
                                                    <strong>
                                                        @DashboardDisplay.FormatMoney(settlementReturn.AmountMinorUnits)
                                                    </strong>
                                                    <small>@settlementReturn.Reason</small>
                                                    @if (settlementReturn.IsRefundProcessing)
                                                    {
                                                        <span class="status-badge is-progress"
                                                              data-return-state="refund-processing">
                                                            Refund čeká na stavové ověření
                                                        </span>
                                                    }
                                                    else if (settlementReturn.IsCompletedReverse)
                                                    {
                                                        <span class="status-badge is-completed"
                                                              data-return-state="reverse-completed">
                                                            Vráceno přes reverse
                                                        </span>
                                                    }
                                                    else if (settlementReturn.IsCompletedRefund)
                                                    {
                                                        <span class="status-badge is-completed"
                                                              data-return-state="refund-completed">
                                                            @(isPartial ? "Partial refund dokončen" : "Vráceno přes full refund")
                                                        </span>
                                                    }
                                                    else if (settlementReturn.IsPreExistingProviderRefund)
                                                    {
                                                        <span class="status-badge is-failed"
                                                              data-return-state="provider-refund-pre-existing">
                                                            ČSOB již eviduje jiný refund; nutná kontrola
                                                        </span>
                                                    }
                                                    else if (settlementReturn.State == SettlementReturnState.Rejected)
                                                    {
                                                        <span class="status-badge is-failed"
                                                              data-return-state="rejected">
                                                            Zamítnuto
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="status-badge is-progress"
                                                              data-return-state="attention">
                                                            Vratka vyžaduje pozornost
                                                        </span>
                                                    }

                                                    @if (settlementReturn.CanRecoverProviderAttempt)
                                                    {
                                                        <form method="post"
                                                              asp-page-handler="@(isPartial ? "PartialRefund" : "Reverse")"
                                                              class="compact-action-form"
                                                              data-return-action="recover"
                                                              data-return-operation-id="@settlementReturn.RequestId">
                                                            <input type="hidden" name="operationId" value="@settlementReturn.RequestId" />
                                                            <input type="hidden" name="originalPaymentId" value="@settlementReturn.OriginalPaymentId" />
                                                            <input type="hidden" name="reason" value="@settlementReturn.Reason" />
                                                            @if (isPartial)
                                                            {
                                                                <input type="hidden"
                                                                       name="amount"
                                                                       value="@((settlementReturn.AmountMinorUnits / 100m).ToString("0.00", CultureInfo.InvariantCulture))" />
                                                            }
                                                            <button type="submit" class="secondary-button">
                                                                Ověřit stav vratky
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }

                                    <p data-return-remaining>
                                        Zbývá bezpečně rezervovat:
                                        <strong>@DashboardDisplay.FormatMoney(remainingMinorUnits)</strong>
                                    </p>

                                    @if (reservedMinorUnits == 0)
                                    {
                                        var fullOperationId = Guid.NewGuid();
                                        <form method="post"
                                              asp-page-handler="Reverse"
                                              class="compact-action-form"
                                              data-return-action="new"
                                              data-return-operation-id="@fullOperationId">
                                            <input type="hidden"
                                                   name="operationId"
                                                   value="@fullOperationId" />
                                            <input type="hidden"
                                                   name="originalPaymentId"
                                                   value="@payment.Id" />
                                            <label>
                                                <span class="visually-hidden">Důvod plné vratky</span>
                                                <input type="text"
                                                       name="reason"
                                                       maxlength="@SettlementReturn.MaximumReasonLength"
                                                       required
                                                       placeholder="Důvod plné vratky" />
                                            </label>
                                            <button type="submit" class="danger-button">
                                                Vrátit celou částku
                                            </button>
                                        </form>
                                    }

                                    @if (remainingMinorUnits > 1)
                                    {
                                        var partialOperationId = Guid.NewGuid();
                                        <form method="post"
                                              asp-page-handler="PartialRefund"
                                              class="compact-action-form"
                                              data-return-action="new-partial"
                                              data-return-operation-id="@partialOperationId">
                                            <input type="hidden"
                                                   name="operationId"
                                                   value="@partialOperationId" />
                                            <input type="hidden"
                                                   name="originalPaymentId"
                                                   value="@payment.Id" />
                                            <label>
                                                <span>Částečná vratka (Kč)</span>
                                                <input type="number"
                                                       name="amount"
                                                       min="0.01"
                                                       max="@(((remainingMinorUnits - 1) / 100m).ToString("0.00", CultureInfo.InvariantCulture))"
                                                       step="0.01"
                                                       required />
                                            </label>
                                            <label>
                                                <span>Důvod</span>
                                                <input type="text"
                                                       name="reason"
                                                       maxlength="@SettlementReturn.MaximumReasonLength"
                                                       required
                                                       placeholder="Důvod částečné vratky" />
                                            </label>
                                            <button type="submit" class="danger-button">
                                                Vrátit zadanou částku
                                            </button>
                                        </form>
                                    }
                                    else if (remainingMinorUnits == 1)
                                    {
                                        <small>
                                            Zbývající 0,01 Kč nelze podle veřejného kontraktu poslat jako partial refund.
                                        </small>
                                    }
                                }
                                else if (
                                    payment.Provider == PaymentProvider.Csob &&
                                    payment.PurposeType == PaymentPurposeType.CreditTopUp &&
                                    payment.Status == PaymentStatus.Succeeded)
                                {
                                    var topUpReturn = settlementReturns.SingleOrDefault();
                                    if (topUpReturn is not null)
                                    {
                                        <div class="return-history" data-return-history>
                                            <div class="return-history-item"
                                                 data-return-id="@topUpReturn.SettlementReturnId">
                                                <strong>
                                                    Celé původní dobití:
                                                    @DashboardDisplay.FormatMoney(topUpReturn.AmountMinorUnits)
                                                </strong>
                                                <small>@topUpReturn.Reason</small>
                                                @if (topUpReturn.IsCompletedReverse || topUpReturn.IsCompletedRefund)
                                                {
                                                    <span class="status-badge is-completed"
                                                          data-return-state="completed">
                                                        Vráceno; kredit byl odečten
                                                    </span>
                                                }
                                                else if (topUpReturn.IsRefundProcessing)
                                                {
                                                    <span class="status-badge is-progress"
                                                          data-return-state="refund-processing">
                                                        Zpracovává se; kredit zůstává rezervován
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="status-badge is-failed"
                                                          data-return-state="attention">
                                                        Vyžaduje kontrolu; kredit zůstává rezervován
                                                    </span>
                                                }

                                                @if (topUpReturn.CanRecoverProviderAttempt)
                                                {
                                                    <form method="post"
                                                          asp-page-handler="ReturnTopUp"
                                                          class="compact-action-form"
                                                          data-return-action="recover-top-up">
                                                        <input type="hidden" name="requestId" value="@topUpReturn.RequestId" />
                                                        <input type="hidden" name="originalPaymentId" value="@payment.Id" />
                                                        <input type="hidden" name="reason" value="@topUpReturn.Reason" />
                                                        <button type="submit" class="secondary-button">
                                                            Ověřit stav vratky
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        var requestId = Guid.NewGuid();
                                        <p>
                                            Vrací se vždy celé původní karetní dobití
                                            <strong>@DashboardDisplay.FormatMoney(payment.AmountMinorUnits)</strong>.
                                            Částka je určena serverem a akce se zablokuje, pokud není celý kredit bezpečně dostupný.
                                        </p>
                                        <form method="post"
                                              asp-page-handler="ReturnTopUp"
                                              class="compact-action-form"
                                              data-return-action="new-top-up"
                                              data-return-operation-id="@requestId">
                                            <input type="hidden" name="requestId" value="@requestId" />
                                            <input type="hidden" name="originalPaymentId" value="@payment.Id" />
                                            <label>
                                                <span>Důvod</span>
                                                <input type="text"
                                                       name="reason"
                                                       maxlength="@SettlementReturn.MaximumReasonLength"
                                                       required
                                                       placeholder="Důvod vrácení celého dobití" />
                                            </label>
                                            <button type="submit" class="danger-button">
                                                Vrátit celé původní dobití
                                            </button>
                                        </form>
                                    }
                                }
                                else
                                {
                                    <span aria-hidden="true">—</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        @if (Model.Payments.Offset > 0 || Model.Payments.HasMore)
        {
            <nav class="pagination" aria-label="Stránkování plateb">
                @if (Model.Payments.Offset > 0)
                {
                    <a asp-page="./Index"
                       asp-route-view="admin"
                       asp-route-status="@Model.Status"
                       asp-route-purposeType="@Model.PurposeType"
                       asp-route-search="@Model.Search"
                       asp-route-offset="@previousOffset">
                        Předchozí
                    </a>
                }
                @if (Model.Payments.HasMore)
                {
                    <a asp-page="./Index"
                       asp-route-view="admin"
                       asp-route-status="@Model.Status"
                       asp-route-purposeType="@Model.PurposeType"
                       asp-route-search="@Model.Search"
                       asp-route-offset="@nextOffset">
                        Další
                    </a>
                }
            </nav>
        }
    </section>


@if (Model.ReconciliationItems.Count > 0)
{
    <section class="data-panel">
        <div class="data-panel-header">
            <div>
                <h2>ČSOB reconciliation</h2>
                <p>Read-only provozní dohled. Finanční stav nelze z tohoto přehledu ručně potvrdit.</p>
            </div>
            <span>@Model.ReconciliationItems.Count otevřených</span>
        </div>
        <div class="responsive-table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Platba</th>
                        <th>payId</th>
                        <th>Stav</th>
                        <th>Pokusy</th>
                        <th>Další pokus</th>
                        <th>ČSOB stav</th>
                        <th>Korelace</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.ReconciliationItems)
                {
                    <tr>
                        <td><code>@item.PaymentId</code></td>
                        <td><code>@item.ProviderReference</code></td>
                        <td>@item.State</td>
                        <td>@item.AttemptCount</td>
                        <td>@DashboardDisplay.FormatDate(item.NextAttemptAt)</td>
                        <td>@(item.LastGatewayPaymentStatus?.ToString() ?? "—")</td>
                        <td><code>@(item.CorrelationId?.ToString() ?? "—")</code></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}
</section>
