<div class="card-acceptance-marks"
     aria-label="Podporované platební karty">
    <span>Platba kartou</span>

    <span class="card-acceptance-marks__logos">
        <img class="card-acceptance-marks__logo card-acceptance-marks__logo--visa"
             src="~/images/payment-methods/visa.png"
