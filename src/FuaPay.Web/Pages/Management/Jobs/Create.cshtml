@page
@model FuaPay.Web.Pages.Management.Jobs.CreateModel
@{
    ViewData["Title"] = "Nová zakázka";
}

<section class="functional-page narrow-page">
    <header class="functional-header split-header">
        <div>
            <p class="panel-kicker">Zakázky</p>
            <h1>Nová zakázka</h1>
            <p>Zakázka vznikne jako koncept. Zákazník ji uvidí až po zveřejnění.</p>
        </div>
        <a asp-page="./Index" asp-route-view="@Model.Context.ViewKey" class="secondary-button">Zpět na zakázky</a>
    </header>

    @if (Model.Context.AvailableServiceUnits.Count == 0)
    {
        <div class="message-box is-warning">Nemáte přiřazené žádné aktivní služby, proto nelze zakázku vytvořit.</div>
    }
    else
    {
        <form method="post" class="data-panel form-stack">
            <input type="hidden" name="view" value="@Model.Context.ViewKey" />
            <div asp-validation-summary="All" class="message-box is-error"></div>

            <label>
                <span>Služba</span>
                <select asp-for="Input.ServiceUnitId">
                    <option value="">Vyberte službu</option>
                    @foreach (var unit in Model.Context.AvailableServiceUnits)
                    {
                        <option value="@unit.Id">@unit.DisplayName</option>
                    }
                </select>
                <span asp-validation-for="Input.ServiceUnitId"></span>
            </label>

            <label>
                <span>Zákazník</span>
                <select asp-for="Input.CustomerUserId" data-searchable-select-source>
                    <option value="">Vyberte zákazníka</option>
                    @foreach (var customer in Model.Customers)
                    {
                        <option value="@customer.Id">@customer.DisplayName · @customer.Email</option>
                    }
                </select>
                <span asp-validation-for="Input.CustomerUserId"></span>
            </label>

            <label>
                <span>Název zakázky</span>
                <input asp-for="Input.Title" />
                <span asp-validation-for="Input.Title"></span>
            </label>

            <label>
                <span>Popis</span>
                <textarea asp-for="Input.Description" rows="7"></textarea>
                <span asp-validation-for="Input.Description"></span>
            </label>

            <label class="price-field">
                <span>Cena v Kč</span>
                <input asp-for="Input.PriceCrowns" type="number" min="@FinancialAmountPolicy.JobPrice.MinimumCrownsInvariant" max="@FinancialAmountPolicy.JobPrice.MaximumCrownsInvariant" step="0.01" />
                <span asp-validation-for="Input.PriceCrowns"></span>
            </label>

            <div class="form-actions">
                <button type="submit" class="primary-action-button">Uložit koncept</button>
            </div>
        </form>
    }
</section>

@section Scripts {
    <script src="~/js/customer-select-filter.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
}
