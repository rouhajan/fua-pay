@page "{id:guid}"
@model FuaPay.Web.Pages.Management.Jobs.EditModel
@{
    ViewData["Title"] = "Upravit zakázku";
}

<section class="functional-page narrow-page">
    <header class="functional-header split-header">
        <div>
            <p class="panel-kicker">@Model.Presentation.Job.Number</p>
            <h1>Upravit koncept</h1>
            <p>Služba: <strong>@Model.Presentation.ServiceUnitDisplayName</strong></p>
        </div>
        <a asp-page="./Details" asp-route-id="@Model.Presentation.Job.Id" asp-route-view="@Model.Context.ViewKey" class="secondary-button">Zpět na detail</a>
    </header>

    <form method="post" class="data-panel form-stack">
        <input type="hidden" name="view" value="@Model.Context.ViewKey" />
        <input type="hidden" asp-for="Input.ServiceUnitId" />
        <div asp-validation-summary="All" class="message-box is-error"></div>

        <label>
            <span>Zákazník</span>
            <select asp-for="Input.CustomerUserId">
                <option value="">Vyberte zákazníka</option>
                @foreach (var customer in Model.Customers)
                {
                    <option value="@customer.Id">@customer.DisplayName · @customer.Email</option>
                }
            </select>
            <span asp-validation-for="Input.CustomerUserId"></span>
        </label>

        <label><span>Název</span><input asp-for="Input.Title" /><span asp-validation-for="Input.Title"></span></label>
        <label><span>Popis</span><textarea asp-for="Input.Description" rows="7"></textarea><span asp-validation-for="Input.Description"></span></label>
        <label class="price-field"><span>Cena v Kč</span><input asp-for="Input.PriceCrowns" type="number" min="@FinancialAmountPolicy.JobPrice.MinimumCrownsInvariant" max="@FinancialAmountPolicy.JobPrice.MaximumCrownsInvariant" step="0.01" /><span asp-validation-for="Input.PriceCrowns"></span></label>

        <div class="form-actions"><button type="submit" class="primary-action-button">Uložit změny</button></div>
    </form>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
