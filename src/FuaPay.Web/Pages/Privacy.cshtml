@page
@{
    ViewData["Title"] = "Ochrana soukromí";
}

<section class="functional-page narrow-page">
    <header class="functional-header">
        <div>
            <p class="panel-kicker">FUA Pay</p>
            <h1>Ochrana soukromí</h1>
            <p>Pracovní informace pro vývojovou verzi.</p>
        </div>
    </header>
