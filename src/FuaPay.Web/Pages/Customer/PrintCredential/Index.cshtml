@page
@model FuaPay.Web.Pages.Customer.PrintCredential.IndexModel
@{
    ViewData["Title"] = "Tiskový kód";
}

<section class="functional-page">
    <header class="functional-header">
        <div>
            <p class="panel-kicker">Zákazník</p>
            <h1>Tiskový kód</h1>
            <p>E-mail a tento trvalý kód zadáte u zadržené tiskové úlohy ve FUA Print.</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="message-box is-success">@Model.SuccessMessage</div>
    }

    @if (Model.Credential is null)
    {
        <div class="message-box is-error">
            Tiskový kód nelze nastavit, protože váš účet nemá jednoznačný synchronizovaný univerzitní e-mail.
        </div>
    }
    else
    {
        <section class="data-panel">
            <div class="data-panel-header">
                <div>
                    <h2>@(Model.Credential.IsConfigured ? "Změnit tiskový kód" : "Nastavit tiskový kód")</h2>
                    <span>Kód zůstává platný, dokud jej nezměníte nebo nezneplatníte.</span>
                </div>
            </div>

            <dl class="detail-grid">
                <div>
                    <dt>Tiskový e-mail</dt>
                    <dd>@Model.Credential.Email</dd>
                </div>
                <div>
                    <dt>Stav</dt>
                    <dd>@(Model.Credential.IsConfigured ? "Aktivní" : "Nenastaven")</dd>
                </div>
            </dl>

            <form method="post" asp-page-handler="Set" class="stacked-form">
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
                <div class="form-field">
                    <label asp-for="Input.PrintCode">Nový šestimístný kód</label>
                    <input asp-for="Input.PrintCode" inputmode="numeric" autocomplete="new-password" maxlength="6" />
                    <span asp-validation-for="Input.PrintCode"></span>
                </div>
                <div class="form-field">
                    <label asp-for="Input.Confirmation">Kód znovu</label>
                    <input asp-for="Input.Confirmation" inputmode="numeric" autocomplete="new-password" maxlength="6" />
                    <span asp-validation-for="Input.Confirmation"></span>
                </div>
                <button type="submit" class="primary-action-button">Uložit tiskový kód</button>
            </form>

            @if (Model.Credential.IsConfigured)
            {
                <form method="post" asp-page-handler="Revoke" class="stacked-form">
                    <button type="submit" class="text-button">Zneplatnit tiskový kód</button>
                </form>
            }
        </section>
    }

    <section class="data-panel">
        <div class="data-panel-header"><h2>Jak tisk funguje</h2></div>
        <p>
            Při každém tisku zadáte ve FUA Print svůj univerzitní e-mail a tento kód.
            Kód není heslem do FUA Pay, nepředstavuje peníze a po tisku se nespotřebuje.
            Po změně přestane předchozí kód okamžitě platit. Před každým tiskem není nutné navštěvovat FUA Pay.
        </p>
    </section>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
