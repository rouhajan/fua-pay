@page
@model FuaPay.Web.Pages.Customer.PrintCredential.IndexModel
@{
    ViewData["Title"] = "Tiskový kód";
}

<section class="functional-page narrow-page">
    <header class="functional-header">
        <div>
            <p class="panel-kicker">Zákazník</p>
            <h1>Tiskový kód</h1>
            <p>E-mail a tento trvalý kód zadáte u zadržené tiskové úlohy ve FUA Print.</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="message-box is-success">@Model.SuccessMessage</div>
    }

    @if (Model.Credential is null)
    {
        <div class="message-box is-error">
            Tiskový credential není pro tento účet dostupný.
        </div>
    }
    else
    {
        @if (!Model.Credential.CanConfigure)
        {
            <div class="message-box is-error">
                Tiskový kód nelze nastavit ani použít, protože aktuální e-mail v profilu FUA Pay chybí, není použitelný nebo není jednoznačný.
                @if (Model.Credential.HasActiveCredential)
                {
                    <text>Již uložený aktivní kód můžete bezpečně zneplatnit níže.</text>
                }
            </div>
        }

        <section class="data-panel">
            <div class="data-panel-header">
                <div>
                    <h2>@(Model.Credential.IsActiveForCurrentEmail ? "Změnit tiskový kód" : "Nastavit tiskový kód")</h2>
                    @if (Model.Credential.CanConfigure)
                    {
                        <span>
                            Pro tisk použijete e-mail <strong>@Model.Credential.CurrentEmail</strong>.
                            Kód zůstává platný, dokud jej nezměníte nebo nezneplatníte.
                        </span>
                    }
                </div>
            </div>

            @if (Model.Credential.CanConfigure)
            {
                <form method="post" asp-page-handler="Set" class="form-stack">
                    <div asp-validation-summary="ModelOnly" class="message-box is-error"></div>
                    <label>
                        <span>Nový šestimístný kód</span>
                        <input asp-for="Input.PrintCode" inputmode="numeric" autocomplete="new-password" maxlength="6" />
                        <span asp-validation-for="Input.PrintCode"></span>
                    </label>
                    <label>
                        <span>Kód znovu</span>
                        <input asp-for="Input.Confirmation" inputmode="numeric" autocomplete="new-password" maxlength="6" />
                        <span asp-validation-for="Input.Confirmation"></span>
                    </label>
                    <div class="form-actions">
                        <button type="submit" class="primary-action-button">Uložit tiskový kód</button>
                    </div>
                </form>
            }

            @if (Model.Credential.HasActiveCredential)
            {
                <form method="post" asp-page-handler="Revoke" class="compact-form">
                    <div class="form-actions">
                        <button type="submit" class="danger-button">Zneplatnit tiskový kód</button>
                    </div>
                </form>
            }
        </section>
    }

    <section class="data-panel">
        <div class="data-panel-header"><h2>Jak tisk funguje</h2></div>
        <p>
            Při každém tisku zadáte ve FUA Print aktuální e-mail uložený v profilu FUA Pay a tento kód.
            Kód není heslem do FUA Pay, nepředstavuje peníze a po tisku se nespotřebuje.
            Po změně přestane předchozí kód okamžitě platit. Před každým tiskem není nutné navštěvovat FUA Pay.
        </p>
    </section>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
