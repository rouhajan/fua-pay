@page
@model FuaPay.Web.Pages.Customer.Jobs.IndexModel
@using FuaPay.Web.Modules.Jobs.Domain
@{
    ViewData["Title"] = "Moje zakázky";
    var previousOffset = Math.Max(0, Model.Jobs.Offset - Model.Jobs.Limit);
    var nextOffset = Model.Jobs.Offset + Model.Jobs.Limit;
}

<section class="functional-page">
    <header class="functional-header">
        <div><p class="panel-kicker">Zákazník</p><h1>Moje zakázky</h1><p>Zobrazené jsou zveřejněné zakázky vedené na váš univerzitní účet.</p></div>
    </header>

    <form method="get" class="filter-grid customer-filter-grid">
        <input type="hidden" name="view" value="customer" />
        <label><span>Číslo nebo název</span><input type="search" name="search" value="@Model.Search" /></label>
        <label>
            <span>Výrobní stav</span>
            <select name="productionStatus">
                <option value="">Všechny</option>
                @foreach (var status in new[] { JobProductionStatus.Published, JobProductionStatus.InProduction, JobProductionStatus.ReadyForPickup, JobProductionStatus.Completed, JobProductionStatus.Cancelled })
                {
                    <option value="@status" selected="@(Model.ProductionStatus == status ? "selected" : null)">@DashboardDisplay.FormatJobProductionStatus(status)</option>
                }
            </select>
        </label>
        <label>
            <span>Úhrada</span>
            <select name="paymentStatus">
                <option value="">Všechny</option>
                <option value="@JobPaymentStatus.Unpaid"
                        selected="@(Model.PaymentStatus == JobPaymentStatus.Unpaid ? "selected" : null)">
                    Neuhrazené
                </option>
                <option value="@JobPaymentStatus.Paid"
                        selected="@(Model.PaymentStatus == JobPaymentStatus.Paid ? "selected" : null)">
                    Uhrazené
                </option>
            </select>
        </label>
        <div class="filter-actions"><button type="submit" class="secondary-button">Použít filtry</button><a asp-page="./Index" asp-route-view="customer" class="text-link">Vyčistit</a></div>
    </form>

    <section class="data-panel">
        <div class="data-panel-header"><h2>Zakázky</h2><span>@Model.Jobs.TotalCount celkem</span></div>
        @if (Model.Rows.Count == 0)
        {
            <div class="empty-state"><p>Zatím zde není žádná odpovídající zakázka.</p></div>
        }
        else
        {
            <div class="responsive-table-wrap">
                <table class="data-table jobs-table">
                    <thead><tr><th>Zakázka</th><th>Služba</th><th>Stav</th><th>Úhrada</th><th>Cena</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td><strong>@row.Job.Title</strong><small>@row.Job.Number · @DashboardDisplay.FormatDate(row.Job.CreatedAt)</small></td>
                            <td><span class="unit-badge">@row.ServiceUnitCode</span> @row.ServiceUnitDisplayName</td>
                            <td><span class="status-badge @DashboardDisplay.JobStatusCssClass(row.Job.ProductionStatus, row.Job.PaymentStatus)">@DashboardDisplay.FormatJobStatus(row.Job.ProductionStatus, row.Job.PaymentStatus)</span></td>
                            <td>@DashboardDisplay.FormatJobPaymentStatus(row.Job.ProductionStatus, row.Job.PaymentStatus)</td>
                            <td><strong>@DashboardDisplay.FormatMoney(row.Job.PriceMinorUnits)</strong></td>
                            <td class="table-action"><a asp-page="./Details" asp-route-id="@row.Job.Id" asp-route-view="customer" class="text-link">Detail</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        @if (Model.Jobs.Offset > 0 || Model.Jobs.HasMore)
        {
            <nav class="pagination">
                @if (Model.Jobs.Offset > 0)
                {
                    <a asp-page="./Index" asp-route-view="customer" asp-route-search="@Model.Search" asp-route-productionStatus="@Model.ProductionStatus" asp-route-paymentStatus="@Model.PaymentStatus" asp-route-offset="@previousOffset">Předchozí</a>
                }
                @if (Model.Jobs.HasMore)
                {
                    <a asp-page="./Index" asp-route-view="customer" asp-route-search="@Model.Search" asp-route-productionStatus="@Model.ProductionStatus" asp-route-paymentStatus="@Model.PaymentStatus" asp-route-offset="@nextOffset">Další</a>
                }
            </nav>
        }
    </section>
</section>
