@page
@{
    ViewData["Title"] = "Podmínky používání";
}

<section class="functional-page narrow-page">
    <header class="functional-header">
        <div>
            <p class="panel-kicker">FUA Pay</p>
            <h1>Podmínky používání</h1>
            <p>Pravidla používání aplikace FUA Pay.</p>
        </div>
    </header>

    <section class="data-panel form-stack">
        <div>
            <h2>Účel služby</h2>
            <p>
                FUA Pay je služba Fakulty umění a architektury Technické
                univerzity v Liberci určená k evidenci zakázek, kreditu
                a plateb za fakultní služby.
            </p>
        </div>

        <div>
            <h2>Přihlášení a účet</h2>
            <p>
                Přístup do FUA Pay probíhá prostřednictvím univerzitní identity.
                Uživatel používá svůj vlastní univerzitní účet a operace
                provedené v aplikaci jsou evidovány pod jeho identitou.
            </p>
        </div>

        <div>
            <h2>Zakázky a platby</h2>
            <p>
                Zakázky a jejich cenu eviduje příslušné fakultní pracoviště.
                Úhrada může podle dostupných možností proběhnout kreditem
                ve FUA Pay nebo prostřednictvím podporované platební služby.
            </p>
            <p>
                Kredit ve FUA Pay je určen k úhradě podporovaných fakultních
                služeb v rámci aplikace.
            </p>
        </div>

        <div>
            <h2>Reklamace a vrácení platby</h2>
            <p>
                Reklamace poskytnuté služby se řeší s pracovištěm, které
                příslušnou službu poskytuje. Případné vrácení platby se provádí
                na základě vyřízení reklamace nebo jiného oprávněného důvodu
                podle pravidel Technické univerzity v Liberci.
            </p>
        </div>

        <div>
            <h2>Správnost údajů</h2>
            <p>
                Pokud uživatel zjistí nesrovnalost v zakázce, kreditu nebo
                platbě, měl by ji bez zbytečného odkladu oznámit příslušnému
                pracovišti nebo správci FUA Pay.
            </p>
        </div>

        <div>
            <h2>Ochrana osobních údajů</h2>
            <p>
                Informace o zpracování osobních údajů jsou uvedeny samostatně
                na stránce
                <a asp-page="/Privacy">Ochrana osobních údajů</a>.
            </p>
        </div>
    </section>
</section>
