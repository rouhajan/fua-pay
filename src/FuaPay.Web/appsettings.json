{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Payments": {
    "Provider": ""
  },
  "DevelopmentSignIn": {
    "Enabled": false
  },
  "DevelopmentData": {
    "Enabled": false,
    "ResetOnStart": false
  },
  "Entra": {
    "Enabled": false,
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": "",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },
  "Csob": {
    "Enabled": false,
    "ApiBaseUrl": "https://iapi.iplatebnibrana.csob.cz/",
    "MerchantId": "",
    "PrivateKeyPath": "",
    "GatewayPublicKeyPath": "",
    "ReturnUrl": "https://localhost/payments/csob/return",
    "PaymentTtlSeconds": 900,
    "RequestTimeoutSeconds": 30,
    "Reconciliation": {
      "PollIntervalSeconds": 15,
      "PendingMinimumAgeSeconds": 15,
      "InProgressMaximumAgeSeconds": 60,
      "LeaseSeconds": 180,
      "BaseBackoffSeconds": 15,
      "MaximumBackoffSeconds": 180,
      "MaximumAttempts": 12,
      "BatchSize": 20
    }
  }
}
